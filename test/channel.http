### Fetch ALL Channels
GRAPHQL http://localhost:3000/graphql

query {
  channels {
    id
    idCategory
    class
    name
  }
}

### Fetch Channel By ID
GRAPHQL http://localhost:3000/graphql

query GetChannel($id: UUID!) {
  channel(id: $id) {
    id
    idCategory
    class
    name
  }
}

{
  "id": "f4641fab-4244-48cc-84b3-cc89c41507c0"
}

### Create Channel
GRAPHQL http://localhost:3000/graphql

mutation CreateChannel($input: CreateChannelInput!) {
  createChannel(input: $input) {
    id,
    idCategory,
    class
    name
  }
}

{
  "input": {
    "class": "text",
    "name": "sdfsdfsdfsdf"
  }
}

### Update Channel
GRAPHQL http://localhost:3000/graphql

mutation UpdateChannel($input: UpdateChannelInput!) {
  updateChannel(input: $input) {
    id,
    idCategory,
    class
    name
  }
}

{
  "input": {
    "id": "7211f4fe-df14-424b-9199-1e24855a2f09",
    "name": "updated"
  }
}